+fn water_transmission_bounds(c: &Container, native: &NativeProgram) -> Option<usize> {
+    if lower::host_max_wave() != 32
+        || !native.wave64
+        || !matches!(native.io, crate::native::StageIo::Cs(cs) if cs.threads == [8, 8, 1])
+    {
+        return None;
+    }
+    let size = c.part(FourCC::DXIL)?.data.len();
+    let init = match (u128::from_be_bytes(c.digest), size) {
+        (0x24126c14_dc7619b0_82ef5712_96038890, 10156) => 0x230, // 5dc3b25986622949
+        (0x7099a57f_ded14261_3b44f410_463d6be6, 15728) => 0x244, // 6f225b641c5b0708
+        _ => return None,
+    };
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    (*ON.get_or_init(|| {
+        std::env::var_os("VICTORY_FOX_WATER_TRANSMISSION_WAVE32")
+            .is_some_and(|value| value == "1")
+    })).then_some(init)
+}
+
+/// A group is one guest wave. For a split host wave, preserve the guest's
+/// scalar branches and keep EXEC as a guard on individual vector operations.
+fn emit_water_transmission(
+    c: &Container,
+    native: &NativeProgram,
+    p: &ir::Program,
+    st: &structure::Structured,
+    init: usize,
+) -> Result<HostShader, ShaderError> {
+    if !p.blocks.iter().flat_map(|block| &block.insts).any(|inst| {
+        inst.machine.offset == init && inst.name() == "ds_write2_b32"
+    }) {
+        return Err(ShaderError::Unsupported {
+            offset: init,
+            what: "the original transmission bounds initializer was not retained",
+        });
+    }
+    let mut wide = st.wide.clone();
+    let add_mask_branches = |wide: &mut std::collections::HashSet<usize>, st: &structure::Structured| {
+        wide.extend(st.wave_any.iter().enumerate().filter_map(|(block, vote)| vote.map(|_| block)));
+    };
+    add_mask_branches(&mut wide, st);
+    loop {
+        let st = structure::structure_wide(p, &wide)?;
+        if wide.iter().any(|&b| st.wave_any[b].is_none()) {
+            return Err(ShaderError::Unsupported {
+                offset: 0,
+                what: "a water transmission branch lost its wave condition",
+            });
+        }
+        let count = wide.len();
+        add_mask_branches(&mut wide, &st);
+        if wide.len() != count {
+            continue;
+        }
+        if let Some(block) = st.exits.iter().enumerate().find_map(|(b, exit)| {
+            let structure::LaneExit::Branch { when, .. } = *exit else { return None };
+            let varying = st.bools.support(when).iter().any(|atom| {
+                !matches!(atom, structure::Atom::Uniform(_))
+            });
+            (!wide.contains(&b) && varying).then_some(b)
+        }) {
+            return Err(ShaderError::Unsupported {
+                offset: p.blocks[block].offset,
+                what: "a water transmission branch depends on an individual lane",
+            });
+        }
+        let io = io::raise(p, native)?;
+        let res = resource::track(p, &native.layout, native.stage, Some(&st))?;
+        let (shader, wave) = emit_program_with_bounds(c, native, p, &st, &io, &res, Some(init))?;
+        if wave != Some(32) {
+            return Err(ShaderError::Unsupported {
+                offset: 0,
+                what: "water transmission did not lower to physical wave32",
+            });
+        }
+        return Ok(shader);
+    }
+}
