+    /// Preserve the native FP32 reduction's DPP8 adds and row exchange, then
+    /// add the upper half's subtotal to the lower half's in native order.
+    fn water_f32_sum(&mut self, mut bits: V) -> Result<V, Why> {
+        if !self.exchange.as_ref().is_some_and(|exchange| !exchange.1)
+            || !self.all_lanes(self.cur_ir)
+        {
+            return Err("a water transmission sum without a whole group exchange");
+        }
+        let c = self.cur;
+        let lane = self.lane_index();
+        for (keep, flip) in [(31, 1), (30, 2), (28, 4), (31, 15), (16, 16)] {
+            let keep = self.s.m.i32(keep);
+            let flip = self.s.m.i32(flip);
+            let source = self.s.m.bin(c, Bin::And, lane, keep);
+            let source = self.s.m.bin(c, Bin::Xor, source, flip);
+            let peer = self.read_lane(bits, source);
+            let peer = self.as_float(peer);
+            let value = self.as_float(bits);
+            let sum = self.s.m.bin(c, Bin::Add, peer, value);
+            bits = self.as_int(sum);
+        }
+        let zero = self.s.m.i32(0);
+        let subtotal = self.read_lane(bits, zero);
+        let (low, high) = self.exchange_halves(c, subtotal);
+        let low = self.as_float(low);
+        let high = self.as_float(high);
+        let sum = self.s.m.bin(c, Bin::Add, high, low);
+        Ok(self.as_int(sum))
     }
 
