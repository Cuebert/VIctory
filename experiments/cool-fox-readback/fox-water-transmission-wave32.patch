+    /// The guest's lane-zero store can be skipped when it has no water. Seed
+    /// the unsigned max and min before any lane can leave the entry block.
+    fn init_water_bounds(&mut self) -> usize {
+        let entry = self.s.entry;
+        let write = self.s.m.new_block();
+        let body = self.s.m.new_block();
+        let flat = self.s.op(entry, "flattenedThreadIdInGroup.i32", Attr::ReadNone, self.s.t.i32, 96, &[]);
+        let zero = self.s.m.i32(0);
+        let one = self.s.m.i32(1);
+        let max = self.s.m.i32(u32::MAX);
+        let leader = self.s.m.cmp(entry, pred::EQ, flat, zero);
+        self.s.m.terminate(entry, Term::CondBr(leader, write, body));
+        let lds = self.s.lds();
+        let farthest = self.s.m.element(write, lds, zero);
+        let nearest = self.s.m.element(write, lds, one);
+        self.s.m.store(write, farthest, zero);
+        self.s.m.store(write, nearest, max);
+        self.s.m.terminate(write, Term::Br(body));
+        let rendezvous = self.s.m.i32(1 | 8);
+        self.s.op(body, "barrier", Attr::NoDuplicate, self.s.t.void, 80, &[rendezvous]);
+        body
     }
 
