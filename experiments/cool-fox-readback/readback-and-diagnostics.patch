+    for (site, refused, [calls, requested_pages, elapsed_ns]) in kernel_ask_stats::take() {
+        if calls != 0 || requested_pages != 0 || elapsed_ns != 0 {
+            tracing::info!(site, refused, calls, requested_pages, elapsed_ns, frames, "GetWriteWatch by call site");
+        }
+    }
