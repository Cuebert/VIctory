+//! One successful Present with paired native hull or cloud neighborhoods.
+use crate::host::HostList;
+use std::fmt::Write;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::core::Interface;
+
+const NORMAL: u32 = 10000;
+const PITCH: usize = 256;
+const STRIDE: usize = 1024;
+const COPY: D3D12_RESOURCE_STATES = D3D12_RESOURCE_STATE_COPY_SOURCE;
+pub(crate) const DEPTH: &str = "2f03a2df10503cef";
+pub(crate) const LIGHT: &str = "1cd9bc634417a981";
+pub(crate) const SKY: &str = "348e1e8c414c7eca";
+pub(crate) const RECONSTRUCT: &str = "982f3cccd5c04294";
+pub(crate) const APPLY: &str = "577248728544d74b";
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Mode {
+    Hull,
+    Cloud,
+}
+
+#[derive(Clone, Copy)]
+struct Request {
+    token: u64,
+    frame: u64,
+    mode: Mode,
+    points: [[u32; 2]; 2],
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Mark {
+    frame: u64,
+    label: &'static str,
+}
+
+struct Sample {
+    mark: Mark,
+    list: usize,
+    fence: u64,
+    ordinal: usize,
+    replayed: bool,
+    resource: usize,
+    format: i32,
+    view_format: i32,
+    state: i32,
+    size: [u32; 2],
+    viewport: [f32; 4],
+    points: [[u32; 2]; 2],
+    bytes: usize,
+    input: &'static str,
+    buffer: ID3D12Resource,
+}
+
+#[derive(Default)]
+struct State {
+    finished: bool,
+    request: Option<Request>,
+    samples: Vec<Sample>,
+}
+
+static REQUEST: Mutex<State> = Mutex::new(State {
+    finished: false,
+    request: None,
+    samples: Vec::new(),
+});
+static ACTIVE: AtomicU64 = AtomicU64::new(0);
+
+fn folder() -> Option<&'static Path> {
+    static FOLDER: OnceLock<Option<PathBuf>> = OnceLock::new();
+    FOLDER
+        .get_or_init(|| {
+            let path = PathBuf::from(std::env::var_os("VICTORY_VISUAL_PAIR")?);
+            (path.is_absolute() && path.is_dir()).then_some(path)
+        })
+        .as_deref()
+}
+
+fn marker(text: &str, frame: u64) -> Option<Request> {
+    let mut words = text.split_whitespace();
+    let token: u64 = words.next()?.parse().ok()?;
+    let mode = match words.next()? {
+        "hull" => Mode::Hull,
+        "cloud" => Mode::Cloud,
+        _ => return None,
+    };
+    let mut points = [[0; 2]; 2];
+    for value in points.iter_mut().flatten() {
+        *value = words.next()?.parse().ok()?;
+        if !(1..NORMAL).contains(value) {
+            return None;
+        }
+    }
+    (token != 0 && points[0] != points[1] && words.next().is_none()).then_some(Request {
+        token,
+        frame,
+        mode,
+        points,
+    })
+}
+
+pub(crate) fn configured() -> bool {
+    folder().is_some()
+}
+
+pub(crate) fn wants_present(frame: u64) -> bool {
+    frame != 0 && ACTIVE.load(Ordering::Acquire) == frame
+}
+
+pub(crate) fn recording() -> bool {
+    wants_present(crate::queue::presented() + 1)
+}
+
+pub(crate) fn wants_shader(hash: &str) -> bool {
+    recording()
+        && REQUEST
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .request
+            .is_some_and(|r| match r.mode {
+                Mode::Hull => matches!(hash, DEPTH | LIGHT),
+                Mode::Cloud => matches!(hash, SKY | RECONSTRUCT | APPLY),
+            })
+}
+
+fn points(normalized: [[u32; 2]; 2], size: [u32; 2], viewport: [f32; 4]) -> Option<[[u32; 2]; 2]> {
+    let [x, y, w, h] = viewport;
+    if !viewport.into_iter().all(f32::is_finite)
+        || x < 0.0
+        || y < 0.0
+        || w <= 0.0
+        || h <= 0.0
+        || x + w > size[0] as f32
+        || y + h > size[1] as f32
+    {
+        return None;
+    }
+    let mapped = normalized.map(|[u, v]| {
+        [
+            (x + w * u as f32 / NORMAL as f32).floor() as u32,
+            (y + h * v as f32 / NORMAL as f32).floor() as u32,
+        ]
+    });
+    (mapped[0] != mapped[1]
+        && mapped
+            .iter()
+            .all(|p| (1..size[0] - 1).contains(&p[0]) && (1..size[1] - 1).contains(&p[1])))
+    .then_some(mapped)
+}
+
+/// Copies raw texels without changing binding state. The caller supplies the
+/// live texture, tracked state and exact viewport when the stage has one.
+pub(crate) fn record(
+    list: &HostList,
+    frame: u64,
+    label: &'static str,
+    source: &ID3D12Resource,
+    state: D3D12_RESOURCE_STATES,
+    view_format: i32,
+    viewport: Option<D3D12_VIEWPORT>,
+    input: &'static str,
+) -> Option<()> {
+    if !wants_present(frame) {
+        return None;
+    }
+    let mut run = REQUEST.lock().unwrap_or_else(|e| e.into_inner());
+    let request = run.request.filter(|r| r.frame == frame)?;
+    if run.samples.len() >= 9 || run.samples.iter().any(|s| s.mark.label == label) {
+        return None;
+    }
+    // SAFETY: a live texture.
+    let desc = unsafe { source.GetDesc() };
+    let bytes = match desc.Format.0 {
+        9..=14 => 8,
+        24..=29 | 39..=43 | 67 | 87 | 90 | 91 => 4,
+        _ => return None,
+    };
+    let size = [u32::try_from(desc.Width).ok()?, desc.Height];
+    if desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D
+        || desc.SampleDesc.Count != 1
+        || desc.MipLevels != 1
+        || desc.DepthOrArraySize != 1
+        || size.into_iter().any(|n| n < 3)
+    {
+        return None;
+    }
+    let viewport = viewport.map_or([0.0, 0.0, size[0] as f32, size[1] as f32], |v| {
+        [v.TopLeftX, v.TopLeftY, v.Width, v.Height]
+    });
+    let points = points(request.points, size, viewport)?;
+    let buffer = crate::host::host()?.read_back_buffer((2 * STRIDE) as u64)?;
+    // SAFETY: the ordinary list is open. Both crop offsets are 512-byte
+    // aligned. Each 3x3 sub-copy fits its 1024-byte slot and texture mip 0.
+    unsafe {
+        if state != COPY {
+            list.list
+                .ResourceBarrier(&[crate::host::transition(source, state, COPY)]);
+        }
+        let from = D3D12_TEXTURE_COPY_LOCATION {
+            pResource: std::mem::transmute_copy(source),
+            Type: D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX,
+            Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 {
+                SubresourceIndex: 0,
+            },
+        };
+        for (i, [x, y]) in points.into_iter().enumerate() {
+            let to = D3D12_TEXTURE_COPY_LOCATION {
+                pResource: std::mem::transmute_copy(&buffer),
+                Type: D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT,
+                Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 {
+                    PlacedFootprint: D3D12_PLACED_SUBRESOURCE_FOOTPRINT {
+                        Offset: (i * STRIDE) as u64,
+                        Footprint: D3D12_SUBRESOURCE_FOOTPRINT {
+                            Format: desc.Format,
+                            Width: 3,
+                            Height: 3,
+                            Depth: 1,
+                            RowPitch: PITCH as u32,
+                        },
+                    },
+                },
+            };
+            let region = D3D12_BOX {
+                left: x - 1,
+                top: y - 1,
+                front: 0,
+                right: x + 2,
+                bottom: y + 2,
+                back: 1,
+            };
+            list.list
+                .CopyTextureRegion(&to, 0, 0, 0, &from, Some(&region));
+        }
+        if state != COPY {
+            list.list
+                .ResourceBarrier(&[crate::host::transition(source, COPY, state)]);
+        }
+    }
+    list.keep(source);
+    list.keep(&buffer);
+    let mark = Mark { frame, label };
+    list.mark_visual(mark);
+    run.samples.push(Sample {
+        mark,
+        list: list.list.as_raw() as usize,
+        fence: 0,
+        ordinal: 0,
+        replayed: false,
+        resource: source.as_raw() as usize,
+        format: desc.Format.0,
+        view_format,
+        state: state.0,
+        size,
+        viewport,
+        points,
+        bytes,
+        input,
+        buffer,
+    });
+    Some(())
+}
+
+pub(crate) fn submitted(runs: &[&HostList], fence: u64) {
+    if ACTIVE.load(Ordering::Acquire) == 0 {
+        return;
+    }
+    for (ordinal, list) in runs.iter().enumerate() {
+        let marks = list.visual_marks();
+        if marks.is_empty() {
+            continue;
+        }
+        let mut run = REQUEST.lock().unwrap_or_else(|e| e.into_inner());
+        for sample in &mut run.samples {
+            if sample.list == list.list.as_raw() as usize && marks.contains(&sample.mark) {
+                sample.replayed |= sample.fence != 0;
+                sample.fence = fence;
+                sample.ordinal = ordinal;
+            }
+        }
+    }
+}
+
+fn raw_words(sample: &Sample) -> Option<String> {
+    let mut data = std::ptr::null_mut();
+    let range = D3D12_RANGE {
+        Begin: 0,
+        End: 2 * STRIDE,
+    };
+    // SAFETY: the caller verifies GPU completion. Every sampled row stays
+    // within its own copy footprint in the mapped readback buffer.
+    unsafe {
+        sample.buffer.Map(0, Some(&range), Some(&mut data)).ok()?;
+        if data.is_null() {
+            sample.buffer.Unmap(0, None);
+            return None;
+        }
+        let mut words = String::new();
+        for block in 0..2 {
+            for row in 0..3 {
+                let offset = block * STRIDE + row * PITCH;
+                let bytes =
+                    std::slice::from_raw_parts(data.cast::<u8>().add(offset), 3 * sample.bytes);
+                for word in bytes.chunks_exact(sample.bytes) {
+                    if !words.is_empty() {
+                        words.push(',');
+                    }
+                    for value in word {
+                        let _ = write!(words, "{value:02x}");
+                    }
+                }
+            }
+        }
+        sample.buffer.Unmap(0, None);
+        Some(words)
+    }
+}
+
+pub(crate) fn after_present(frame: u64, success: bool, completed: u64) {
+    let Some(folder) = folder() else { return };
+    let mut run = REQUEST.lock().unwrap_or_else(|e| e.into_inner());
+    if run.finished {
+        return;
+    }
+    if let Some(request) = run.request {
+        if frame < request.frame {
+            return;
+        }
+        ACTIVE.store(0, Ordering::Release);
+        run.finished = true;
+        // D3D12 reports UINT64_MAX on device removal.
+        let eligible = |s: &Sample| {
+            s.fence != 0 && completed != u64::MAX && s.fence <= completed && !s.replayed
+        };
+        let final_fence = run
+            .samples
+            .iter()
+            .find(|s| s.mark.label == "present")
+            .filter(|s| eligible(s))
+            .map(|s| s.fence);
+        let mut out = format!(
+            "frame={} target={} token={} mode={:?} success={} completed={} final_fence={:?}\n",
+            frame, request.frame, request.token, request.mode, success, completed, final_fence
+        );
+        out.push_str("stage\tinput\tlist\tfence\tordinal\tresource\tformat\tview_format\tstate\tsize\tviewport\tpoints\tstatus\twords_le\n");
+        for s in &run.samples {
+            let words = (success
+                && frame == request.frame
+                && eligible(s)
+                && final_fence.is_some_and(|end| s.mark.label == "present" || s.fence < end))
+            .then(|| raw_words(s))
+            .flatten();
+            let _ = writeln!(
+                out,
+                "{}\t{}\t{:#x}\t{}\t{}\t{:#x}\t{}\t{}\t{:#x}\t{:?}\t{:?}\t{:?}\t{}\t{}",
+                s.mark.label,
+                s.input,
+                s.list,
+                s.fence,
+                s.ordinal,
+                s.resource,
+                s.format,
+                s.view_format,
+                s.state,
+                s.size,
+                s.viewport,
+                s.points,
+                if words.is_some() {
+                    "fenced"
+                } else {
+                    "unqualified"
+                },
+                words.as_deref().unwrap_or("")
+            );
+        }
+        let expected: &[&str] = match request.mode {
+            Mode::Hull => &[
+                "base-before-depth-resolve",
+                "resolved-depth",
+                "first-light-hdr-before",
+                "first-light-hdr-after",
+                "present",
+            ],
+            Mode::Cloud => &[
+                "sky-after",
+                "cloud-history",
+                "cloud-output",
+                "apply-radiance",
+                "apply-hdr-before",
+                "apply-hdr-after",
+                "present",
+            ],
+        };
+        for label in expected {
+            if !run.samples.iter().any(|s| s.mark.label == *label) {
+                let _ = writeln!(out, "{label}\t\t\t\t\t\t\t\t\t\t\t\tmissing\t");
+            }
+        }
+        run.samples.clear();
+        if let Err(error) = std::fs::write(
+            folder.join(format!("visual-{}-p{frame}.tsv", request.token)),
+            out,
+        ) {
+            tracing::warn!(%error, frame, "could not save visual pair");
+        }
+        return;
+    }
+    if !success || frame & 15 != 0 {
+        return;
+    }
+    let Ok(file) = std::fs::File::open(folder.join("visual-frame.txt")) else {
+        return;
+    };
+    let mut text = String::new();
+    if file.take(97).read_to_string(&mut text).is_err() || text.len() > 96 {
+        return;
+    }
+    if let Some(request) = marker(&text, crate::queue::presented().max(frame) + 2) {
+        run.request = Some(request);
+        ACTIVE.store(request.frame, Ordering::Release);
+        tracing::info!(token=request.token, frame=request.frame, mode=?request.mode, "armed visual pair");
+    }
+}
