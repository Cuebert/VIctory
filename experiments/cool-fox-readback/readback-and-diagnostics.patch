+#[derive(Clone, Copy)]
+enum KernelAskSite {
+    Ahead,
+    Rest,
+    Writes,
+    TextureTracked,
+    TextureGuarded,
+    Early,
+}
+
+#[cfg(feature = "diagnostics")]
+mod kernel_ask_stats {
+    use super::KernelAskSite;
+    use std::sync::OnceLock;
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+    #[derive(Default)]
+    struct Bucket {
+        calls: AtomicU64,
+        requested_pages: AtomicU64,
+        elapsed_ns: AtomicU64,
+    }
+
+    impl Bucket {
+        const fn new() -> Self {
+            Self { calls: AtomicU64::new(0), requested_pages: AtomicU64::new(0), elapsed_ns: AtomicU64::new(0) }
+        }
+
+        fn note(&self, requested_pages: u64, elapsed_ns: u64) {
+            self.calls.fetch_add(1, Relaxed);
+            self.requested_pages.fetch_add(requested_pages, Relaxed);
+            self.elapsed_ns.fetch_add(elapsed_ns, Relaxed);
+        }
+
+        fn drain(&self) -> [u64; 3] {
+            [self.calls.swap(0, Relaxed), self.requested_pages.swap(0, Relaxed), self.elapsed_ns.swap(0, Relaxed)]
+        }
+    }
+
+    const LABELS: [&str; 6] = ["ask_ahead", "ask_rest", "writes", "texture_tracked", "texture_guarded", "ask_early"];
+    static BY_SITE: [[Bucket; 2]; LABELS.len()] = [const { [Bucket::new(), Bucket::new()] }; LABELS.len()];
+
+    pub(super) fn enabled() -> bool {
+        static ENABLED: OnceLock<bool> = OnceLock::new();
+        *ENABLED.get_or_init(|| std::env::var_os("VICTORY_WRITE_WATCH_SPLIT").is_some_and(|value| value == "1"))
+    }
+
+    pub(super) fn note(site: KernelAskSite, refused: bool, requested_pages: u64, elapsed_ns: u64) {
+        BY_SITE[site as usize][usize::from(refused)].note(requested_pages, elapsed_ns);
+    }
+
+    pub(super) fn take() -> impl Iterator<Item = (&'static str, bool, [u64; 3])> {
+        LABELS.into_iter().zip(&BY_SITE).flat_map(|(site, rows)| {
+            rows.iter().enumerate().map(move |(refused, row)| (site, refused != 0, row.drain()))
+        })
+    }
+}
