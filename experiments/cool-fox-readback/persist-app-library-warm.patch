+/// Use the native application library for an isolated, serial replay.
+pub fn use_application_library(dir: PathBuf) {
+    super::library::use_pipeline_cache(dir);
+}
+
+/// Accumulated native pipeline builds and successful named library loads.
+pub fn application_library_counts() -> (u64, u64) {
+    use std::sync::atomic::Ordering::Relaxed;
+    use super::library::{LOADED, MADE};
+    (MADE.load(Relaxed), LOADED.load(Relaxed))
+}
+
+/// Save compiled pipelines only. Original recipes and usage hints remain input.
+pub fn finish_application_library() -> (u64, u64, bool) {
+    let (made, loaded) = application_library_counts();
+    let saved = if made == 0 { loaded != 0 } else { super::library::save_compiled_only() };
+    (made, loaded, saved)
 }
 
