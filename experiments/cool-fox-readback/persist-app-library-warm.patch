+/// Build or reopen a small private application library in one device process.
+pub fn persist_application_library(jobs: Option<usize>, limit: Option<usize>, used: bool) -> Result<()> {
+    anyhow::ensure!(jobs.unwrap_or(1) == 1, "Persistent replay uses one process");
+    let limit = limit.context("Supply a persistent replay limit from 1 to 40")?;
+    anyhow::ensure!((1..=AT_ONCE).contains(&limit), "Supply a persistent replay limit from 1 to 40");
+    let dir = folder()?;
+    let lock = std::fs::OpenOptions::new()
+        .create(true).truncate(false).write(true).open(dir.join("warm-app-library.lock"))?;
+    lock.try_lock().context("This private application library is in use")?;
+    known::use_translations(dir.with_file_name("shaders"));
+    known::use_application_library(dir.clone());
+
+    let configuration = [
+        "VICTORY_D3D12_ADAPTER", "VICTORY_EXPECT_NVIDIA_LUID",
+        "VICTORY_FOX_WATER_TRANSMISSION_WAVE32", "VICTORY_PIXEL_QUAD_DPP8",
+        "VICTORY_HOST_MAX_WAVE", "VICTORY_DXIL",
+    ].map(|name| (name, std::env::var(name).unwrap_or_default()));
+    let id = format!("{} {configuration:?}", known::fingerprint());
+    let identity_path = dir.join("warm-app-library-id.txt");
+    match std::fs::read_to_string(&identity_path) {
+        Ok(old) => anyhow::ensure!(old == id, "Application library configuration changed"),
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => {
+            anyhow::ensure!(!dir.join("host-pipelines.bin").exists() && !dir.join("host-pipelines.next").exists(),
+                "Persistent replay needs its own application library folder");
+            std::fs::OpenOptions::new().create_new(true).write(true).open(identity_path)?.write_all(id.as_bytes())?;
+        }
+        Err(err) => return Err(err.into()),
+    }
+
+    let reopening = dir.join("host-pipelines.bin").is_file() || dir.join("host-pipelines.next").is_file();
+    let keys = known::keys(&dir);
+    let early = std::fs::read_to_string(dir.join("early-pipelines.txt"))?;
+    let early: HashSet<_> = early.lines().collect();
+    let mut selected: Vec<_> = (0..keys.len())
+        .filter(|&n| !used || early.contains(keys[n].as_str()))
+        .collect();
+    selected.sort_by_key(|&n| (!early.contains(keys[n].as_str()), &keys[n]));
+    selected.truncate(limit);
+    anyhow::ensure!(!selected.is_empty(), "No recipes matched the persistent replay plan");
+
+    let mut accepted = 0;
+    let mut completed = 0;
+    let mut previous = known::application_library_counts();
+    known::make(&dir, &selected, |n, result| {
+        match result {
+            Some((ms, there)) => {
+                accepted += usize::from(there);
+                completed += 1;
+                let (made, loaded) = known::application_library_counts();
+                let (new_made, new_loaded) = (made - previous.0, loaded - previous.1);
+                previous = (made, loaded);
+                println!("app-library recipe {n} {} ms={ms:.2} accepted={there} made={new_made} loaded={new_loaded}", keys[n]);
+            }
+            None => println!("app-library building recipe {n} {}", keys[n]),
+        }
+    });
+    let (made, loaded, saved) = known::finish_application_library();
+    println!("app-library completed={completed} accepted={accepted} made={made} loaded={loaded} saved={saved}");
+    anyhow::ensure!(!reopening || loaded != 0, "Existing application library produced no native loads");
+    anyhow::ensure!(completed == selected.len() && accepted != 0 && saved,
+        "Persistent application pipeline replay did not retain any accepted recipes");
+    Ok(())
+}
