+fn compact_joined_ranges(ranges: &mut Vec<(usize, usize)>) {
+    let mut kept = 0;
+    for index in 0..ranges.len() {
+        let (from, to) = ranges[index];
+        if kept > 0 && from <= ranges[kept - 1].1 {
+            ranges[kept - 1].1 = ranges[kept - 1].1.max(to);
+        } else {
+            ranges[kept] = (from, to);
+            kept += 1;
+        }
+    }
+    ranges.truncate(kept);
