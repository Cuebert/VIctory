+/// With only independent fills on the card, there are no title-memory
+/// writes to order. Copies that might interact with those fills go through
+/// the full planner, including its ordering checks and refusal reasons.
+fn plan_fills(does: &[Does]) -> Option<Vec<(usize, u32)>> {
+    let mut chosen = Vec::new();
+    let mut copy_destinations = Vec::new();
+    for (index, step) in does.iter().enumerate() {
+        match *step {
+            Does::Fill { asked: true, to: true, .. } => chosen.push((index, 0)),
+            Does::Fill { asked: false, .. } | Does::Read { asked: false, .. } | Does::Refresh { .. } => {}
+            Does::Copy { dst, len, asked: false, .. } | Does::Placed { dst, len, .. } => {
+                copy_destinations.push((dst, dst + len));
+            }
+            _ => return None,
+        }
+    }
+    if chosen.len() > MOST {
+        return None;
+    }
+    if !copy_destinations.is_empty() {
+        let mut reads = Vec::new();
+        join_ranges(&mut reads, chosen.iter().map(|&(index, _)| {
+            let Does::Fill { src, len, .. } = does[index] else { unreachable!() };
+            (src, src + len)
+        }));
+        if copy_destinations.into_iter().any(|dst| touched(&reads, dst)) {
+            return None;
+        }
+    }
+    Some(chosen)
+}
